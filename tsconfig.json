{
  // code-shape R1b (Sep 27 2026): tsc is now the TYPE GATE only (gate 3) —
  // esbuild (scripts/build.mjs) does the actual bundling/emit.
  // R1 · fix r1 (should, Sep 27 2026): "include": ["app.ts"] alone gated
  // ONLY the files app.ts imports transitively — tsc --listFiles showed 11,
  // down from 13 at 95bcc3f, silently dropping ladders.ts and progression.ts
  // from the type gate (neither is imported by app.ts) and making this
  // comment's claim wrong. A glob keeps every .ts file (still respecting the
  // excludes below) in the gate the way it used to be — verified on a scratch
  // copy: 13 files, clean.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist", "tests", "playwright.config.ts"]
}
