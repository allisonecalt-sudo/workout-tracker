{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "VariableDeclarator[id.type='ObjectPattern'][init.name='ui']",
        "message": "Never destructure ui (const { x } = ui): the copy stops tracking. Read and write ui.x in place."
      },
      {
        "selector": "AssignmentExpression[left.type='ObjectPattern'][right.name='ui']",
        "message": "Never destructure ui ({ x } = ui): the copy stops tracking. Read and write ui.x in place."
      }
    ],
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["state.ts", "bus.ts", "screens/**/*.ts"],
      "rules": {
        "max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    }
  ],
  "ignorePatterns": ["dist/", "node_modules/", "tests/", "playwright.config.ts", "archive/"]
}
