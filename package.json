{
  "name": "workout-tracker",
  "version": "0.1.0",
  "description": "Allison's hands-free home workout tracker (A/B/C rotation, tempo timer, log)",
  "private": true,
  "appVersion": "v62.3",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,html,css,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,html,css,json,md}\" --ignore-path .prettierignore",
    "test": "playwright test",
    "test:full": "node scripts/pw-run.mjs",
    "test:fast": "node scripts/pw-run.mjs --fast",
    "test:ci": "playwright test",
    "titles:check": "node scripts/check-titles.mjs",
    "titles:update": "node scripts/check-titles.mjs --update",
    "verify:commits": "node scripts/verify-commits.mjs",
    "golden:update": "node scripts/update-golden.mjs",
    "serve": "serve -l 3000 .",
    "prepare": "husky",
    "wt:add": "node scripts/worktree.mjs add",
    "wt:remove": "node scripts/worktree.mjs remove"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "prettier": "^3.3.0",
    "serve": "^14.2.0",
    "typescript": "^5.6.0"
  }
}
